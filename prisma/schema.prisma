generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  role              String             @default("STUDENT")
  isActive          Boolean            @default(true)
  institutionId     String?
  grade             String?
  xp                Int                @default(0)
  level             Int                @default(1)
  streak            Int                @default(0)
  lastActive        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  isDemo            Boolean            @default(false)
  licenseType       String             @default("DEMO")
  expiresAt         DateTime?
  accounts          Account[]
  createdActivities Activity[]
  activityAttempts  ActivityAttempt[]
  bookViews         BookView[]
  classes           Class[]
  clubMemberships   ClubMember[]
  comments          Comment[]
  createdCourses    Course[]
  courseEnrollments CourseEnrollment[]
  evaluations       EvaluationResult[]
  notes             Note[]
  posts             Post[]
  readingSessions   ReadingSession[]
  sessions          Session[]
  institution       Institution?       @relation(fields: [institutionId], references: [id])
  activities        UserActivity[]
  readings          UserBook[]
  challenges        UserChallenge[]
  videos            Video[]
  vocabulary        Vocabulary[]
  twoFactor         TwoFactor?
  enrolledClasses   Class[]            @relation("ClassStudents")

  @@index([institutionId])
  @@index([grade])
  @@index([isDemo])
}

model UserChallenge {
  id          String   @id @default(cuid())
  userId      String
  challengeId Int
  weekNumber  Int
  claimedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId, weekNumber])
  @@index([userId, weekNumber])
}

model Institution {
  id               String                  @id @default(cuid())
  name             String
  domain           String                  @unique
  city             String?
  country          String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  endDate          DateTime?
  maxStudents      Int                     @default(30)
  plan             String                  @default("TRIAL")
  startDate        DateTime                @default(now())
  status              String                  @default("trial")
  isLibraryRestricted Boolean                 @default(false)
  gradeCollections    BookCollectionByGrade[]
  classes          Class[]
  users            User[]

  @@index([domain])
}

model BookCollectionByGrade {
  id            String                      @id @default(cuid())
  institutionId String?
  grade         String
  name          String
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  institution   Institution?                @relation(fields: [institutionId], references: [id])
  books         BookCollectionByGradeBook[]

  @@unique([institutionId, grade, name])
  @@index([grade])
}

model BookCollectionByGradeBook {
  id           String                @id @default(cuid())
  collectionId String
  bookId       String
  book         Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  collection   BookCollectionByGrade @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, bookId])
  @@index([bookId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id               String                      @id @default(cuid())
  title            String
  author           String
  description      String?
  coverImage       String?
  category         String
  language         String
  difficulty       String
  format           String
  contentUrl       String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  published        Boolean                     @default(true)
  ageRange         String?
  grade            String?
  isDemo           Boolean                     @default(false)
  quizId           String?
  selWorkshopId    String?
  subject          String?
  allowMultipleAttempts Boolean           @default(false)
  passScore        Int                         @default(60)
  displaySettings  String?                     // JSON: {"scale":1,"offsetX":0,"offsetY":0}
  audioUrl         String?                     // URL del audio en Vercel Blob Storage
  audioSyncMap     String?                     // JSON: {pages: [{pageNum, words: [{word, start, end}]}]}
  linkedActivities Activity[]
  assignments      Assignment[]
  gradeCollections BookCollectionByGradeBook[]
  views            BookView[]
  clubs            Club[]
  moduleItems      CourseModuleItem[]
  evaluations      Evaluation[]
  notes            Note[]
  sessions         ReadingSession[]
  activities       UserActivity[]
  users            UserBook[]
  vocabulary       Vocabulary[]
  assignedClasses  Class[]                     @relation("ClassBooks")

  @@index([grade])
  @@index([subject])
  @@index([isDemo])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  path      String?
  bookId    String?
  metadata  String?
  createdAt DateTime @default(now())
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([bookId, createdAt])
}

model BookView {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  path      String?
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookId, createdAt])
  @@index([createdAt])
}

model UserBook {
  id       String   @id @default(cuid())
  userId   String
  bookId   String
  progress Int      @default(0)
  status   String   @default("IN_PROGRESS")
  lastRead DateTime @default(now())
  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, bookId])
}

model ReadingSession {
  id              String    @id @default(cuid())
  userId          String
  bookId          String
  chapterId       String?
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationSeconds Int       @default(0)
  pagesRead       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id            String       @id @default(cuid())
  name          String
  teacherId     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  grade         String?
  isDemo        Boolean      @default(false)
  subject       String?
  institutionId String?
  assignments   Assignment[]
  institution   Institution? @relation(fields: [institutionId], references: [id])
  teacher       User         @relation(fields: [teacherId], references: [id])
  students      User[]       @relation("ClassStudents")
  assignedBooks Book[]       @relation("ClassBooks")

  @@index([teacherId])
  @@index([institutionId])
  @@index([isDemo])
}

model Assignment {
  id          String   @id @default(cuid())
  classId     String
  bookId      String
  title       String
  dueDate     DateTime?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id])
}

model Evaluation {
  id        String             @id @default(cuid())
  bookId    String
  type      String             @default("QUIZ")
  content   String
  createdAt DateTime           @default(now())
  book      Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  results   EvaluationResult[]
}

model EvaluationResult {
  id           String     @id @default(cuid())
  userId       String
  evaluationId String
  score        Float
  feedback     String?
  createdAt    DateTime   @default(now())
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
}

model Vocabulary {
  id         String   @id @default(cuid())
  userId     String
  bookId     String?
  bookTitle  String?
  word       String
  definition String
  context    String?
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  book       Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  bookId    String?
  bookTitle String?
  page      Int
  text      String
  quote     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book?    @relation(fields: [bookId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key   String @id
  value String
}

model Club {
  id          String       @id @default(cuid())
  name        String
  description String
  coverImage  String?
  bookId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  book        Book?        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  members     ClubMember[]
  posts       Post[]
}

model ClubMember {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, clubId])
}

model Post {
  id        String    @id @default(cuid())
  content   String
  userId    String
  clubId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  club      Club      @relation(fields: [clubId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Course {
  id          String             @id @default(cuid())
  title       String
  description String?
  teacherId   String
  published   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  activities  Activity[]
  teacher     User               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments CourseEnrollment[]
  modules     CourseModule[]
  videos      Video[]

  @@index([teacherId, createdAt])
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  role      String   @default("STUDENT")
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId, createdAt])
}

model CourseModule {
  id        String             @id @default(cuid())
  courseId  String
  title     String
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items     CourseModuleItem[]

  @@index([courseId, order])
}

model CourseModuleItem {
  id         String       @id @default(cuid())
  moduleId   String
  type       String
  order      Int          @default(0)
  bookId     String?
  activityId String?
  videoId    String?
  createdAt  DateTime     @default(now())
  activity   Activity?    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  book       Book?        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video      Video?       @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([moduleId, order])
  @@index([bookId, createdAt])
  @@index([activityId, createdAt])
  @@index([videoId, createdAt])
}

model Activity {
  id          String             @id @default(cuid())
  title       String
  description String?
  type        String
  content     String
  points      Int                @default(100)
  published   Boolean            @default(true)
  createdById String
  courseId    String?
  bookId      String?
  chapterId   String?
  pageStart   Int?
  pageEnd     Int?
  excerpt     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  book        Book?              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attempts    ActivityAttempt[]
  moduleItems CourseModuleItem[]

  @@index([createdById, createdAt])
  @@index([courseId, createdAt])
  @@index([bookId, createdAt])
}

model ActivityAttempt {
  id          String    @id @default(cuid())
  activityId  String
  userId      String
  score       Float     @default(0)
  answers     String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
  @@index([userId, createdAt])
}

model Video {
  id              String             @id @default(cuid())
  title           String
  description     String?
  provider        String
  url             String
  durationSeconds Int?
  teacherId       String
  courseId        String?
  published       Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  moduleItems     CourseModuleItem[]
  course          Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher         User               @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
  @@index([courseId, createdAt])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String   @unique
  token   String   @unique
  expires DateTime
  createdAt DateTime @default(now())
}

model Translation {
  id             String   @id @default(cuid())
  hash           String   @unique // sha1(originalText + targetLanguage)
  originalText   String   // Optional: stored for reference or debugging
  translatedText String
  targetLanguage String
  engine         String   // e.g. "claude", "openai"
  createdAt      DateTime @default(now())

  @@index([hash])
}

/// Append-only log of privileged actions (admin/superadmin/teacher destructive ops).
/// Used for forensic investigation after an incident. NEVER updated, only inserted.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?  // who did it (null for anonymous/system)
  actorEmail  String?  // snapshot of actor email at time of action
  actorRole   String?  // snapshot of actor role
  action      String   // e.g. "USER_DELETE", "BOOK_UPDATE", "LICENSE_RENEW"
  resource    String?  // e.g. "User", "Book", "Class"
  resourceId  String?  // the id of the affected entity
  ip          String?
  userAgent   String?
  metadata    String?  // JSON: extra context (before/after, params)
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@index([createdAt])
}

/// TOTP-based 2FA secret per user. Mandatory for ADMIN/SUPERADMIN after enrollment.
/// Recovery codes are bcrypt-hashed in `recoveryCodes` (newline-separated).
model TwoFactor {
  id             String   @id @default(cuid())
  userId         String   @unique
  secret         String   // base32 TOTP secret (do NOT log)
  enabled        Boolean  @default(false)
  recoveryCodes  String?  // bcrypt-hashed codes separated by '\n'
  enabledAt      DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
